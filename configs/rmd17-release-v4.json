764257abf8121a0905f364468ba83da", "mimetype": "text/csv"}, {"id": 62265769, "name": "index_test_02.csv", "size": 5887, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/62265769", "supplied_md5": "9dc098724c1680daca038b785ee4f602", "computed_md5": "9dc098724c1680daca038b785ee4f602", "mimetype": "text/csv"}, {"id": 62265772, "name": "index_train_02.csv", "size": 5888, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/62265772", "supplied_md5": "28dbc9a3d5e7c47e653b1cc01809df35", "computed_md5": "28dbc9a3d5e7c47e653b1cc01809df35", "mimetype": "text/csv"}, {"id": 62265775, "name": "index_train_03.csv", "size": 5895, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/62265775", "supplied_md5": "8de68b1b288c790e633c9d05ff5f04dd", "computed_md5": "8de68b1b288c790e633c9d05ff5f04dd", "mimetype": "text/csv"}, {"id": 62265778, "name": "index_train_05.csv", "size": 5880, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/62265778", "supplied_md5": "4670362bd554c9c22581c936432236b3", "computed_md5": "4670362bd554c9c22581c936432236b3", "mimetype": "text/csv"}, {"id": 62265781, "name": "index_test_01.csv", "size": 5896, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/62265781", "supplied_md5": "124c8a0849e84e244d6ce8424e1c05cf", "computed_md5": "124c8a0849e84e244d6ce8424e1c05cf", "mimetype": "text/csv"}, {"id": 62265784, "name": "index_test_05.csv", "size": 5886, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/62265784", "supplied_md5": "4892da12e88a3c30c9a15f1f95e6eaac", "computed_md5": "4892da12e88a3c30c9a15f1f95e6eaac", "mimetype": "text/csv"}, {"id": 62265787, "name": "index_test_03.csv", "size": 5888, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/62265787", "supplied_md5": "fd96f4623291dc23dd80b24dd634ca0b", "computed_md5": "fd96f4623291dc23dd80b24dd634ca0b", "mimetype": "text/csv"}, {"id": 62265790, "name": "index_test_04.csv", "size": 5880, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/62265790", "supplied_md5": "f0acce759fa4fe46b3a0b2a450e7e260", "computed_md5": "f0acce759fa4fe46b3a0b2a450e7e260", "mimetype": "text/csv"}, {"id": 62265793, "name": "index_train_01.csv", "size": 5880, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/62265793", "supplied_md5": "22264dcf2e42d6133362411abbbe4ce8", "computed_md5": "22264dcf2e42d6133362411abbbe4ce8", "mimetype": "text/csv"}], "folder_structure": {}, "authors": [{"id": 5674127, "full_name": "Anders S. Christensen", "first_name": "Anders S.", "last_name": "Christensen", "is_active": true, "url_name": "Anders_S_Christensen", "orcid_id": "0000-0002-7253-6897"}, {"id": 541397, "full_name": "Anatole Von lilienfeld", "first_name": "Anatole", "last_name": "Von lilienfeld", "is_active": true, "url_name": "Anatole_Von_lilienfeld", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://figshare.com/articles/dataset/Revised_MD17_dataset_rMD17_/12672038", "download_disabled": false, "description": "<p dir=\"ltr\">THE REVISED MD17 dataset:</p><p><br><br>=========================</p><p dir=\"ltr\">Citation:</p><p><br>========</p><p dir=\"ltr\"><br>Anders S. Christensen and O. Anatole von Lilienfeld (2020) \"On the role of gradients for machine learning of molecular energies and forces\" https://arxiv.org/abs/2007.09593</p><p dir=\"ltr\"><br><br>The molecules are taken from the original MD17 dataset by Chmiela et al., and 100,000 structures are taken, and the energies and forces are recalculated at the PBE/def2-SVP level of theory using very tight SCF convergence and very dense DFT integration grid. As such, the dataset is practically free from nummerical noise.</p><p dir=\"ltr\"><br>One warning: As the structures are taken from a molecular dynamics simulation (i.e. time series data), they are not guaranteed to be independent samples. This is easily evident from the autocorrelation function for the original MD17 dataset</p><p dir=\"ltr\"><br><br>In short: DO NOT train a model on more than 1000 samples from this dataset. Data already published with 50K samples on the original MD17 dataset should be considered meaningless due to this fact and due to the noise in the original data.</p><p dir=\"ltr\">The data:</p><p><br>=========</p><p dir=\"ltr\"><br>The ten molecules are save in Numpy .npz format.</p><p dir=\"ltr\"><br>The keys correspond to:</p><p dir=\"ltr\">'nuclear_charges' : The nuclear charges for the molecule</p><p dir=\"ltr\">'coords' : The coordinates for each conformation (in units of \u00e5ngstrom)</p><p dir=\"ltr\">'energies' : The total energy of each conformation (in units of kcal/mol)</p><p dir=\"ltr\">'forces' : The cartesian forces of each conformation (in units of kcal/mol/\u00e5ngstrom)</p><p dir=\"ltr\">'old_indices' : The index of each conformation in the original MD17 dataset</p><p dir=\"ltr\">'old_energies' : The energy of each conformation taken from the original MD17 dataset (in units of kcal/mol)</p><p dir=\"ltr\"><br>'old_forces' : The forces of each conformation taken from the original MD17 dataset (in units of kcal/mol/\u00e5ngstrom)</p><p dir=\"ltr\"><br><br>*Note that for Azobenzene, only 99988 samples are available due to 11 failed DFT calculations, and the original dataset only contained 99999 structures.</p><p dir=\"ltr\">Data splits:</p><p>============</p><p dir=\"ltr\"><br><br>Five training and test splits are saved in CSV format containing the corresponding indices.</p><p dir=\"ltr\">Update 2026-02-28: Raw npz and csv are uploaded outside of the tar file to enable direct download of the files</p>", "funding": "This work was partly supported by the NCCR MARVEL, funded by the Swiss National Science. O.A.v.L. acknowledges funding from the Swiss National Science foundation (407540\\_167186 NFP 75 Big Data) and from the European Research Council (ERC-CoG grant QML).", "funding_list": [{"id": 18640184, "title": "This work was partly supported by the NCCR MARVEL, funded by the Swiss National Science. O.A.v.L. acknowledges funding from the Swiss National Science foundation (407540\\_167186 NFP 75 Big Data) and from the European Research Council (ERC-CoG grant QML).", "grant_code": "", "funder_name": null, "is_user_defined": 1}], "version": 4, "status": "public", "size": 2213587907, "created_date": "2026-02-28T16:12:06Z", "modified_date": "2026-02-28T16:12:06Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 2, "name": "CC0", "url": "https://creativecommons.org/publicdomain/zero/1.0/"}, "tags": ["chemistry", "molecules", "molecular dynamics", "forces", "energies", "Quantum Chemistry"], "keywords": ["chemistry", "molecules", "molecular dynamics", "forces", "energies", "Quantum Chemistry"], "categories": [{"id": 25267, "title": "Theoretical quantum chemistry", "parent_id": 25255, "path": "/25066/25255/25267", "source_id": "340704", "taxonomy_id": 100}], "references": ["https://arxiv.org/abs/2007.09593"], "has_linked_file": false, "citation": "Christensen, Anders S.; Von lilienfeld, Anatole (2020). Revised MD17 dataset (rMD17). figshare. Dataset. https://doi.org/10.6084/m9.figshare.12672038.v4", "related_materials": [{"id": 271341061, "identifier": "https://arxiv.org/abs/2007.09593", "title": "", "relation": "References", "identifier_type": "URL", "is_linkout": false, "link": "https://arxiv.org/abs/2007.09593"}], "is_embargoed": false, "embargo_date": null, "embargo_type": "article", "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 12672038, "title": "Revised MD17 dataset (rMD17)", "doi": "10.6084/m9.figshare.12672038.v4", "handle": "", "url": "https://api.figshare.com/v2/articles/12672038", "published_date": "2026-02-28T16:12:06Z", "thumb": "", "defined_type": 3, "defined_type_name": "dataset", "group_id": null, "url_private_api": "https://api.figshare.com/v2/account/articles/12672038", "url_public_api": "https://api.figshare.com/v2/articles/12672038", "url_private_html": "https://figshare.com/account/articles/12672038", "url_public_html": "https://figshare.com/articles/dataset/Revised_MD17_dataset_rMD17_/12672038", "timeline": {"posted": "2026-02-28T16:12:06", "firstOnline": "2020-07-18"}, "resource_title": null, "resource_doi": null}